{
  "name": "trazo-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . && stylelint \"src/**/*.{scss,vue}\" --allow-empty-input && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "playwright test",
    "docs:ts": "typedoc",
    "test:e2e:ops": "playwright test --grep @operacion --project=portatil"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@quasar/extras": "^2.1.0",
    "axios": "^1.20.0",
    "grid-layout-plus": "^1.1.1",
    "laravel-echo": "^2.6.1",
    "pinia": "^4.1.0",
    "pusher-js": "^8.6.0",
    "qrcode": "^1.5.4",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^31.0.0",
    "otpauth": "^9.5.2",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.106.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
