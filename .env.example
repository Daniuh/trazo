# Variables del stack de Docker. Copiar a .env solo si se quiere cambiar algún valor:
# sin .env, `docker compose up -d` funciona en local con estos mismos valores por defecto.
# Los valores marcados como "solo local" NUNCA se usan en producción, donde son obligatorios.

# Puertos publicados en el host
TRAZO_HTTP_PORT=8088
TRAZO_MAIL_UI_PORT=8025

# Aplicación
APP_ENV=local
APP_URL=http://localhost:8088
# Vacío en local: se genera sola y se guarda en un volumen. En producción es obligatoria.
APP_KEY=

# Sesión: duración máxima y cierre por inactividad, en minutos
SESSION_MAX_MINUTES=480
SESSION_IDLE_MINUTES=60

# Incidentes de demostración (fuera de producción). La prueba pide al menos 500
SEED_INCIDENTS=600

# Base de datos (solo local)
DB_DATABASE=trazo
DB_USERNAME=trazo
DB_PASSWORD=trazo_local_only
DB_ROOT_PASSWORD=trazo_root_local_only

# Redis (solo local)
REDIS_PASSWORD=trazo_local_only

# Correo: en local va a Mailpit; en producción, al SMTP configurado
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@trazo.local

# Tiempo real (Reverb). La clave es pública (la recibe el navegador); el secreto, no. Solo local los valores de abajo.
# REVERB_ALLOWED_ORIGINS: dominios desde los que se aceptan conexiones, separados por comas y sin esquema
REVERB_APP_ID=trazo
REVERB_APP_KEY=trazo-local-key
REVERB_APP_SECRET=trazo_local_only
REVERB_ALLOWED_ORIGINS=localhost
