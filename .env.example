# Variables del stack de Docker. Copiar a .env solo si se quiere cambiar algún valor:
# sin .env, `docker compose up -d` funciona en local con estos mismos valores por defecto.
# Los valores marcados como "solo local" NUNCA se usan en producción, donde son obligatorios.

# Puertos publicados en el host
TRAZO_HTTP_PORT=8088
TRAZO_MAIL_UI_PORT=8025

# Aplicación
APP_ENV=local
APP_URL=http://localhost:8088
# Vacío en local: se genera sola y se guarda en un volumen. En producción es obligatoria.
APP_KEY=

# Sesión: duración máxima y cierre por inactividad, en minutos
SESSION_MAX_MINUTES=480
SESSION_IDLE_MINUTES=60

# Incidentes de demostración (fuera de producción). La prueba pide al menos 500
SEED_INCIDENTS=600
# En producción no se cargan, salvo que se active esto (sitio de evaluación); se reparten entre las cuentas por rol
SEED_INCIDENTS_IN_PRODUCTION=false

# Juegos de cuentas, una por rol, que se crean también en producción y piden escanear el QR al primer ingreso.
# El correo lleva {rol} (superadmin, admin, supervisor, agente, solicitante). Vacíos: no se crean.
# Las contraseñas reales solo van en el entorno del servidor, nunca en el repositorio. Ver docs/operacion/cuentas.md
EVALUATION_EMAIL_PATTERN=
OWNER_EMAIL_PATTERN=
OWNER_LABEL=Daniel Naranjo
EVALUATION_PASSWORD=
OWNER_PASSWORD=

# Prefijo del código de los incidentes (TZ-26-0142). Se define antes de producción: cambiarlo después exige migrar los códigos
INCIDENT_CODE_PREFIX=TZ

# Días que se guardan los eventos del sistema ya resueltos
SYSTEM_EVENTS_RETENTION_DAYS=90

# Días que se guardan las notificaciones de cada persona, leídas o no
NOTIFICATIONS_RETENTION_DAYS=90

# Base de datos (solo local)
DB_DATABASE=trazo
DB_USERNAME=trazo
DB_PASSWORD=trazo_local_only
DB_ROOT_PASSWORD=trazo_root_local_only

# Respaldo diario de la base. La llave cifra los respaldos: vacía en local (se genera sola y se guarda en un volumen),
# obligatoria en producción y guardada aparte del servidor (sin ella, los respaldos no se pueden abrir)
BACKUP_ENCRYPTION_KEY=
BACKUP_AT=03:00
BACKUP_TIMEZONE=America/Bogota
BACKUP_RETENTION_DAYS=7

# Redis (solo local)
REDIS_PASSWORD=trazo_local_only

# Correo: en local va a Mailpit; en producción, al SMTP configurado
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@trazo.local

# Tiempo real (Reverb). La clave es pública (la recibe el navegador); el secreto, no. Solo local los valores de abajo.
# REVERB_ALLOWED_ORIGINS: dominios desde los que se aceptan conexiones, separados por comas y sin esquema
REVERB_APP_ID=trazo
REVERB_APP_KEY=trazo-local-key
REVERB_APP_SECRET=trazo_local_only
REVERB_ALLOWED_ORIGINS=localhost

# Peticiones por minuto a la API por persona (solo se sube para un escaneo o una prueba de carga local)
API_RATE_LIMIT=120
