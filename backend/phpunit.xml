<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuración de pruebas: corren contra MySQL real (base trazo_test), nunca contra SQLite.
     Se usa <server> con force="true" para que las variables del contenedor (p. ej. la base de desarrollo) no se cuelen en las pruebas. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- La suite corre en un solo proceso y supera los 256 MB de las peticiones web (docker/php/conf.d/app.ini) -->
        <ini name="memory_limit" value="512M"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_DEBUG" value="false" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_LIMITER_STORE" value="array" force="true"/>
        <server name="DB_CONNECTION" value="mysql" force="true"/>
        <server name="DB_DATABASE" value="trazo_test" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="SEED_INCIDENTS" value="0" force="true"/>
        <server name="LOG_CHANNEL" value="null" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
    </php>
</phpunit>
