{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "strict_comparison": true,
        "strict_param": true,
        "final_internal_class": false,
        "global_namespace_import": {
            "import_classes": true,
            "import_constants": false,
            "import_functions": false
        }
    },
    "exclude": ["bootstrap/cache", "storage", "vendor"]
}
